<?xml version="1.0" encoding="utf-8"?>
<!--
  TemizWeb yedeklenmez: tercihler cihazda kalır. Gizlilik ilkesi uzantıyla aynıdır,
  ayarlar bile buluta çıkmaz.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
